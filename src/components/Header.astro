---
/* Shared AVM/ system header */
import { NAV_ITEMS } from "../consts";

interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;
---

<header class="header" role="banner">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Home">
      <span class="monogram">AVM/</span>
      <span class="logo-text">Photography</span>
    </a>
    <nav id="main-navigation" class="nav" role="navigation" aria-label="Main navigation">
      {NAV_ITEMS.map(item => (
        <a
          href={item.href}
          class={currentPage === item.id ? 'active' : ''}
          aria-current={currentPage === item.id ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>
    <button class="mobile-toggle" aria-label="Toggle menu" aria-controls="main-navigation" aria-expanded="false" type="button">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector('.mobile-toggle');
  const nav = document.querySelector('.nav');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', (!expanded).toString());
    nav?.classList.toggle('open');
    document.body.classList.toggle('menu-open');
    if (!expanded) nav?.querySelector('a')?.focus();
  });

  document.addEventListener('click', (event) => {
    if (!nav?.classList.contains('open')) return;
    const target = event.target as Node;
    if (!nav.contains(target) && !toggle?.contains(target)) {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('menu-open');
    }
  });

  nav?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab' || !nav.classList.contains('open')) return;
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
    if (!links.length) return;
    if (event.shiftKey && document.activeElement === links[0]) {
      event.preventDefault();
      links.at(-1)?.focus();
    } else if (!event.shiftKey && document.activeElement === links.at(-1)) {
      event.preventDefault();
      links[0].focus();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('open')) {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('menu-open');
      toggle?.focus();
    }
  });

  nav?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('menu-open');
    });
  });
</script>

<style>
  .header {
    position: fixed;
    top: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    padding: 0.5rem;
    border-radius: 999px;
    background: oklch(18% 0.008 55 / 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 2px 20px oklch(0% 0 0 / 0.15);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem 0.25rem 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-paper);
    opacity: 0.85;
    transition: opacity var(--dur-short) var(--ease-out);
    margin-right: 0.5rem;
  }
  .logo:hover { opacity: 1; }

  .logo-text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.05em;
    color: var(--color-paper);
  }

  .monogram {
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-accent);
  }

  .nav {
    display: flex;
    gap: 0.125rem;
    align-items: center;
  }

  .nav a {
    color: oklch(96% 0.006 75 / 0.65);
    font-size: var(--text-sm);
    font-weight: 400;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    transition: all var(--dur-short) var(--ease-out);
    white-space: nowrap;
  }

  .nav a:hover {
    color: var(--color-paper);
    background: oklch(96% 0.006 75 / 0.08);
  }

  .nav a.active {
    color: var(--color-paper);
    background: var(--color-accent);
    font-weight: 500;
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
    flex-direction: column;
    gap: 4px;
    color: var(--color-paper);
    opacity: 0.7;
  }

  .bar {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: all var(--dur-short) var(--ease-out);
  }

  .mobile-toggle[aria-expanded="true"] .bar:nth-child(1) {
    transform: rotate(45deg) translate(4px, 4px);
  }
  .mobile-toggle[aria-expanded="true"] .bar:nth-child(2) {
    transform: rotate(-45deg) translate(4px, -4px);
  }

  @media (max-width: 640px) {
    .header {
      top: var(--space-sm);
      padding: 0.35rem;
    }

    .header-inner {
      gap: 0;
      padding: 0.2rem 0.35rem 0.2rem 0.75rem;
    }

    .logo-text { display: none; }

    .nav {
      display: none;
      position: fixed;
      top: 0;
      right: -75%;
      width: 75%;
      max-width: 280px;
      height: 100vh;
      background: oklch(14% 0.008 55);
      flex-direction: column;
      gap: 0;
      padding: 5rem var(--space-lg) var(--space-lg);
      z-index: 200;
      transition: right var(--dur-long) var(--ease-out);
    }
    .nav.open { display: flex; right: 0; }

    .nav a {
      font-size: var(--text-base);
      padding: var(--space-md) 0;
      border-bottom: 1px solid oklch(96% 0.006 75 / 0.06);
      border-radius: 0;
      width: 100%;
    }
    .nav a.active { background: none; color: var(--color-accent); }

    .mobile-toggle { display: flex; }
  }

  :global(body.menu-open) { overflow: hidden; }
  :global(body.menu-open::after) {
    content: '';
    position: fixed;
    inset: 0;
    background: oklch(0% 0 0 / 0.4);
    z-index: 150;
  }

  /* Shared AVM header: full-width, technical, and quieter than the gallery. */
  .header {
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    transform: none;
    padding: 0;
    border-radius: 0;
    background: oklch(18% 0.008 55 / 0.92);
    border-bottom: 1px solid oklch(96% 0.006 75 / 0.1);
    box-shadow: none;
  }

  .header-inner {
    width: min(1200px, calc(100% - 2rem));
    min-height: 68px;
    margin: 0 auto;
    padding: 0;
    justify-content: space-between;
  }

  .logo { margin-right: 2rem; }
  .logo-text { font-family: var(--font-mono); font-size: var(--text-sm); letter-spacing: 0.04em; color: var(--color-ink); }
  .nav { gap: 0.25rem; }
  .nav a {
    border-radius: 2px;
    padding: 0.55rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nav a:hover { color: var(--color-ink); background: rgba(0, 230, 138, 0.1); }
  .nav a.active { background: transparent; color: var(--color-accent); font-weight: 500; }
  .mobile-toggle { color: var(--color-ink); }

  @media (max-width: 640px) {
    .header { top: 0; padding: 0; }
    .header-inner { width: calc(100% - 2rem); min-height: 60px; padding: 0; }
    .logo { margin-right: 0; }
    .logo-text { display: inline; }
    .nav {
      display: flex;
      top: 0;
      right: -100%;
      width: min(80%, 300px);
      max-width: none;
      padding: 5rem var(--space-lg) var(--space-lg);
      background: oklch(14% 0.008 55);
      border-left: 1px solid oklch(96% 0.006 75 / 0.1);
    }
    .nav.open { right: 0; }
    .nav a { width: 100%; min-height: 44px; padding: 0.85rem 0; border-bottom: 1px solid oklch(96% 0.006 75 / 0.08); }
    .nav a.active { background: transparent; color: var(--color-accent); }
    .mobile-toggle { display: flex; }
  }
</style>
