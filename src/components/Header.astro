---
/* Hallmark · component: N5 Floating pill */
import { NAV_ITEMS } from "../consts";

interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;
---

<header class="header" role="banner">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Home">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="28" height="28" aria-hidden="true">
        <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <path d="M 50 50 L 50 15" stroke="currentColor" stroke-width="1" fill="none"/>
        <path d="M 50 50 L 75 30" stroke="currentColor" stroke-width="1" fill="none"/>
        <path d="M 50 50 L 85 50" stroke="currentColor" stroke-width="1" fill="none"/>
        <path d="M 50 50 L 75 70" stroke="currentColor" stroke-width="1" fill="none"/>
        <path d="M 50 50 L 50 85" stroke="currentColor" stroke-width="1" fill="none"/>
        <path d="M 50 50 L 25 70" stroke="currentColor" stroke-width="1" fill="none"/>
        <path d="M 50 50 L 15 50" stroke="currentColor" stroke-width="1" fill="none"/>
        <path d="M 50 50 L 25 30" stroke="currentColor" stroke-width="1" fill="none"/>
        <circle cx="50" cy="50" r="7" fill="currentColor"/>
      </svg>
      <span class="logo-text">AV</span>
    </a>
    <nav class="nav" role="navigation" aria-label="Main navigation">
      {NAV_ITEMS.map(item => (
        <a
          href={item.href}
          class={currentPage === item.id ? 'active' : ''}
          aria-current={currentPage === item.id ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>
    <button class="mobile-toggle" aria-label="Toggle menu" aria-expanded="false" type="button">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector('.mobile-toggle');
  const nav = document.querySelector('.nav');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', (!expanded).toString());
    nav?.classList.toggle('open');
    document.body.classList.toggle('menu-open');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('open')) {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('menu-open');
      toggle?.focus();
    }
  });

  nav?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('menu-open');
    });
  });
</script>

<style>
  .header {
    position: fixed;
    top: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    padding: 0.5rem;
    border-radius: 999px;
    background: oklch(18% 0.008 55 / 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 2px 20px oklch(0% 0 0 / 0.15);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem 0.25rem 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-paper);
    opacity: 0.85;
    transition: opacity var(--dur-short) var(--ease-out);
    margin-right: 0.5rem;
  }
  .logo:hover { opacity: 1; }

  .logo-text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.05em;
    color: var(--color-paper);
  }

  .nav {
    display: flex;
    gap: 0.125rem;
    align-items: center;
  }

  .nav a {
    color: oklch(96% 0.006 75 / 0.65);
    font-size: var(--text-sm);
    font-weight: 400;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    transition: all var(--dur-short) var(--ease-out);
    white-space: nowrap;
  }

  .nav a:hover {
    color: var(--color-paper);
    background: oklch(96% 0.006 75 / 0.08);
  }

  .nav a.active {
    color: var(--color-paper);
    background: var(--color-accent);
    font-weight: 500;
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
    flex-direction: column;
    gap: 4px;
    color: var(--color-paper);
    opacity: 0.7;
  }

  .bar {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: all var(--dur-short) var(--ease-out);
  }

  .mobile-toggle[aria-expanded="true"] .bar:nth-child(1) {
    transform: rotate(45deg) translate(4px, 4px);
  }
  .mobile-toggle[aria-expanded="true"] .bar:nth-child(2) {
    transform: rotate(-45deg) translate(4px, -4px);
  }

  @media (max-width: 640px) {
    .header {
      top: var(--space-sm);
      padding: 0.35rem;
    }

    .header-inner {
      gap: 0;
      padding: 0.2rem 0.35rem 0.2rem 0.75rem;
    }

    .logo-text { display: none; }

    .nav {
      display: none;
      position: fixed;
      top: 0;
      right: -75%;
      width: 75%;
      max-width: 280px;
      height: 100vh;
      background: oklch(14% 0.008 55);
      flex-direction: column;
      gap: 0;
      padding: 5rem var(--space-lg) var(--space-lg);
      z-index: 200;
      transition: right var(--dur-long) var(--ease-out);
    }
    .nav.open { display: flex; right: 0; }

    .nav a {
      font-size: var(--text-base);
      padding: var(--space-md) 0;
      border-bottom: 1px solid oklch(96% 0.006 75 / 0.06);
      border-radius: 0;
      width: 100%;
    }
    .nav a.active { background: none; color: var(--color-accent); }

    .mobile-toggle { display: flex; }
  }

  :global(body.menu-open) { overflow: hidden; }
  :global(body.menu-open::after) {
    content: '';
    position: fixed;
    inset: 0;
    background: oklch(0% 0 0 / 0.4);
    z-index: 150;
  }
</style>
