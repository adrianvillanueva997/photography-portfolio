---
import Logo from "./Logo.astro";
import { NAV_ITEMS } from "../consts";

interface Props {
	currentPage?: string;
}

const { currentPage } = Astro.props;
---

<header class="header" role="banner">
  <div class="header-container">
    <a href="/" class="logo-link" aria-label="Adrian Villanueva - Home">
      <Logo size="small" />
      <span class="logo-text">Adrian Villanueva</span>
    </a>
    <nav class="nav" role="navigation" aria-label="Main navigation">
      {
        NAV_ITEMS.map((item, i) => (
          <>
            {i > 0 && <span class="nav-dot" aria-hidden="true"></span>}
            <a href={item.href} class={currentPage === item.id ? 'active' : ''} aria-current={currentPage === item.id ? 'page' : undefined}>{item.label}</a>
          </>
        ))
      }
    </nav>
    <button class="mobile-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span class="hamburger"></span>
      <span class="hamburger"></span>
      <span class="hamburger"></span>
    </button>
  </div>
  <div class="header-line" aria-hidden="true"></div>
</header>

<script>
  const toggle = document.querySelector('.mobile-toggle');
  const nav = document.querySelector('.nav');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', (!expanded).toString());
    nav?.classList.toggle('open');
    document.body.classList.toggle('menu-open');
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('open')) {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('menu-open');
      toggle?.focus();
    }
  });

  // Close when link clicked
  nav?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('menu-open');
    });
  });
</script>

<style>
  .header {
    background: transparent;
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: rgba(12, 11, 9, 0.85);
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.25rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .header-line {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-border) 20%,
      var(--color-primary-dim) 50%,
      var(--color-border) 80%,
      transparent 100%
    );
    opacity: 0.6;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: opacity 0.3s;
  }

  .logo-link:hover {
    opacity: 0.7;
  }

  .logo-text {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .nav-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-border-light);
  }

  .nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.3s;
    padding: 0.5rem 0.75rem;
    position: relative;
  }

  .nav a:hover {
    color: var(--color-text);
  }

  .nav a.active {
    color: var(--color-primary);
    text-shadow: 0 0 8px rgba(200, 164, 90, 0.4);
  }

  .nav a.active::after {
    display: none;
  }

  @media (max-width: 768px) {
    .header-container {
      padding: 0.85rem 1.25rem;
      flex-direction: row;
      gap: 0;
    }

    .logo-text {
      font-size: 0.85rem;
      letter-spacing: 0.04em;
    }

    .nav {
      gap: 0;
    }

    .nav-dot {
      display: none;
    }

    .nav a {
      font-size: 0.65rem;
      padding: 0.4rem 0.5rem;
      letter-spacing: 0.08em;
    }
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 200;
  }

  .hamburger {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text-secondary);
    transition: all 0.3s ease;
  }

  .mobile-toggle[aria-expanded="true"] .hamburger:nth-child(1) {
    transform: rotate(45deg) translate(4px, 4px);
  }

  .mobile-toggle[aria-expanded="true"] .hamburger:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle[aria-expanded="true"] .hamburger:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  @media (max-width: 480px) {
    .header-container {
      padding: 0.75rem 1rem;
    }

    .logo-link {
      gap: 0.5rem;
    }

    .logo-text {
      font-size: 0.75rem;
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .nav {
      display: none;
      position: fixed;
      top: 0;
      right: -100%;
      width: 70%;
      max-width: 260px;
      height: 100vh;
      background: var(--color-bg);
      flex-direction: column;
      gap: 0;
      padding: 5rem 2rem 2rem;
      border-left: 1px solid var(--color-border);
      z-index: 150;
      transition: right 0.3s ease;
    }

    .nav.open {
      display: flex;
      right: 0;
    }

    .nav a {
      font-size: 0.85rem;
      padding: 1rem 0;
      border-bottom: 1px solid var(--color-border);
      width: 100%;
    }

    .nav a.active::after {
      display: none;
    }
  }

  :global(body.menu-open) {
    overflow: hidden;
  }

  :global(body.menu-open::after) {
    content: '';
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 140;
  }
</style>
