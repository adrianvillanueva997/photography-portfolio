---
interface Props {
  id: string;
  title: string;
  image: string;
  metadata: {
    camera: string;
    lens: string;
    settings: { iso: number | number[]; aperture: string; shutter: string; focalLength: number | string; };
    location: string;
    dateTaken: string;
  };
}

const { id, title, image, metadata } = Astro.props;

const baseUrl = image.replace(/-display\.\w+$/, '');
const ext = image.match(/\.(\w+)$/)?.[1] || 'avif';
const thumbnailUrl = `${baseUrl}-thumbnail.${ext}`;
const collectionUrl = `${baseUrl}-collection.${ext}`;
const displayUrl = `${baseUrl}-display.${ext}`;
const thumbWebp = `${baseUrl}-thumbnail.webp`;
const collWebp = `${baseUrl}-collection.webp`;
const displayWebp = `${baseUrl}-display.webp`;

const isoValue = Array.isArray(metadata.settings.iso) ? metadata.settings.iso[0] : metadata.settings.iso;
---

<article class="card">
  <a href={`/photos/${id}`} class="link" data-lightbox-trigger={id}>
    <picture>
      <source srcset={`${displayUrl} 1400w, ${collectionUrl} 700w, ${thumbnailUrl} 350w`} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, (max-width: 1400px) 33vw, 25vw" type="image/avif" />
      <source srcset={`${displayWebp} 1400w, ${collWebp} 700w, ${thumbWebp} 350w`} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, (max-width: 1400px) 33vw, 25vw" type="image/webp" />
      <img src={thumbnailUrl} alt={title} loading="lazy" decoding="async" width="350" height="auto" />
    </picture>
    <div class="caption">
      <span class="title">{title}</span>
      <span class="meta mono">{metadata.location} &middot; {metadata.settings.aperture}</span>
    </div>
  </a>
</article>

<style>
  .card {
    break-inside: avoid;
    margin-bottom: var(--space-lg);
    width: 100%;
  }

  .link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .link:hover .title {
    color: var(--color-accent);
  }

  picture,
  img {
    display: block;
    width: 100%;
    height: auto;
  }

  .caption {
    padding: var(--space-sm) 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-ink-2);
    line-height: 1.3;
    transition: color var(--dur-short) var(--ease-out);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-muted);
    letter-spacing: 0.03em;
  }

  .mono { font-family: var(--font-mono); }
</style>
