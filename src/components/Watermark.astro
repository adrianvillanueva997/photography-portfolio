---
interface Props {
  photographer?: string;
}

const { photographer = "© Adrian Villanueva" } = Astro.props;
---

<div class="watermark" aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 50" class="watermark-svg">
    <text x="100" y="28" text-anchor="middle" class="text">{photographer}</text>
  </svg>
</div>

<style>
  .watermark {
    position: absolute;
    bottom: var(--space-md);
    right: var(--space-md);
    width: 160px;
    height: 36px;
    pointer-events: none;
    z-index: 10;
  }

  .watermark-svg { width: 100%; height: 100%; }

  .text {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: oklch(96% 0.006 75 / 0.3);
    letter-spacing: 0.5px;
  }

  @media (max-width: 640px) {
    .watermark {
      width: 120px;
      height: 28px;
      bottom: var(--space-sm);
      right: var(--space-sm);
    }
    .text { font-size: 8px; }
  }
</style>
