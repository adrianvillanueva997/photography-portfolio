---
interface Props {
  photoCount: number;
  collectionCount: number;
}

const { photoCount, collectionCount } = Astro.props;
---

<div class="stats">
  <div class="stat">
    <span class="num">{photoCount}</span>
    <span class="label mono">photographs</span>
  </div>
  <span class="sep" aria-hidden="true"></span>
  <div class="stat">
    <span class="num">{collectionCount}</span>
    <span class="label mono">collections</span>
  </div>
  <span class="sep" aria-hidden="true"></span>
  <div class="stat">
    <span class="num">GR III</span>
    <span class="label mono">current camera</span>
  </div>
</div>

<style>
  .stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-xl);
    padding: var(--space-lg) 0;
    border-block: 1px solid var(--color-rule);
    margin: 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .num {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mono { font-family: var(--font-mono); }

  .sep {
    width: 1px;
    height: 2rem;
    background: var(--color-rule);
  }

  @media (max-width: 640px) {
    .stats { gap: var(--space-md); flex-wrap: wrap; }
    .num { font-size: var(--text-xl); }
  }
</style>
