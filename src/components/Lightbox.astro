---
import Watermark from "./Watermark.astro";

interface Props {
  id: string;
  image: string;
  thumbnail: string;
  title: string;
  metadata: {
    camera: string;
    lens: string;
    settings: {
      iso: number | number[];
      aperture: string;
      shutter: string;
      focalLength: number | string;
    };
    location: string;
    dateTaken: string;
  };
}

const { id, image, thumbnail, title, metadata } = Astro.props;
const isoValue = Array.isArray(metadata.settings.iso) ? metadata.settings.iso[0] : metadata.settings.iso;
const shareUrl = `https://avm.photography/photos/${id}`;
---

<div class="lightbox" id={`lightbox-${id}`} role="dialog" aria-modal="true" aria-label={title}>
  <div class="backdrop"></div>
  <div class="content">
    <button class="close" aria-label="Close" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="image-area">
      <div class="spinner-wrap" aria-hidden="true">
        <div class="spinner"></div>
      </div>
      <picture>
        <source srcset={image} type="image/avif" />
        <source srcset={image.replace(/\.\w+$/, '.webp')} type="image/webp" />
        <img src={image} alt={title} class="main-img" data-thumb={thumbnail} />
      </picture>
      <Watermark />
    </div>

    <div class="info">
      <h2 class="photo-title">{title}</h2>
      <div class="exif">
        <span class="exif-item">{metadata.camera.replace('RICOH IMAGING COMPANY, LTD. ', '')}</span>
        <span class="exif-dot" aria-hidden="true"></span>
        <span class="exif-item">{metadata.settings.aperture}</span>
        <span class="exif-dot" aria-hidden="true"></span>
        <span class="exif-item">{metadata.settings.shutter}</span>
        <span class="exif-dot" aria-hidden="true"></span>
        <span class="exif-item">ISO {isoValue}</span>
        <span class="exif-dot" aria-hidden="true"></span>
        <span class="exif-item">{metadata.location}</span>
        <span class="exif-dot" aria-hidden="true"></span>
        <span class="exif-item">{metadata.dateTaken.replace(/:/g, '.')}</span>
      </div>
      <button class="share" type="button" aria-label="Share">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
        </svg>
        <span>Share</span>
      </button>
    </div>
  </div>
</div>

<script define:vars={{ id, shareUrl }}>
  var lb = document.getElementById('lightbox-' + id);
  var lastFocused = null;

  function open() {
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
    lastFocused = document.activeElement;
    var c = lb.querySelector('.close');
    if (c) c.focus();
  }
  function close() {
    lb.classList.remove('open');
    document.body.style.overflow = '';
    if (lastFocused) lastFocused.focus();
    lastFocused = null;
  }
  lb.__open = open;

  var img = lb.querySelector('.main-img');
  var sp = lb.querySelector('.spinner-wrap');
  function loaded() { if (sp) sp.classList.add('done'); }
  if (img) {
    if (img.complete) loaded();
    else { img.addEventListener('load', loaded); img.addEventListener('error', loaded); }
  }

  lb.querySelector('.close').addEventListener('click', function(e) { e.stopPropagation(); close(); });

  lb.addEventListener('keydown', function(e) {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'Tab') {
      var f = lb.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
      if (!f.length) return;
      if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f[f.length-1].focus(); }
      else if (!e.shiftKey && document.activeElement === f[f.length-1]) { e.preventDefault(); f[0].focus(); }
    }
  });

  document.addEventListener('keydown', function(e) {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') { close(); return; }
    if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
      e.preventDefault();
      var triggers = document.querySelectorAll('[data-lightbox-trigger]');
      var idx = -1;
      triggers.forEach(function(t, i) { if (t.getAttribute('data-lightbox-trigger') === id) idx = i; });
      var next = e.key === 'ArrowRight' ? triggers[(idx + 1) % triggers.length] : triggers[(idx - 1 + triggers.length) % triggers.length];
      if (next) { close(); setTimeout(function() { next.click(); }, 50); }
    }
  });

  var shareBtn = lb.querySelector('.share');
  shareBtn.addEventListener('click', function() {
    var t = lb.querySelector('.photo-title');
    var text = (t ? t.textContent : '') || 'Photograph';
    if (navigator.share) { navigator.share({ title: text, text: 'Photo by Adrian Villanueva', url: shareUrl }).catch(function(){}); }
    else if (navigator.clipboard) {
      navigator.clipboard.writeText(shareUrl).then(function() {
        var l = shareBtn.querySelector('span');
        if (l) { var o = l.textContent; l.textContent = 'Copied!'; setTimeout(function() { l.textContent = o; }, 2000); }
      });
    }
  });
</script>

<style>
  .lightbox {
    position: fixed; inset: 0; z-index: 1000;
    opacity: 0; visibility: hidden;
    transition: all var(--dur-long) var(--ease-out);
  }
  .lightbox.open { opacity: 1; visibility: visible; }

  .backdrop {
    position: absolute; inset: 0;
    background: oklch(12% 0.008 55 / 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .content {
    position: absolute; inset: 0;
    z-index: 1001;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: var(--space-lg);
  }

  .close {
    position: fixed; top: var(--space-md); right: var(--space-md);
    background: none; border: none;
    color: oklch(96% 0.006 75 / 0.4);
    cursor: pointer; padding: var(--space-sm);
    transition: all var(--dur-short) var(--ease-out);
    z-index: 1002;
  }
  .close:hover { color: var(--color-paper); transform: rotate(90deg); opacity: 1; }

  .image-area {
    position: relative;
    flex: 1; display: flex;
    align-items: center; justify-content: center;
    width: 100%; min-height: 0;
    max-height: calc(100vh - 160px);
  }

  .spinner-wrap {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    z-index: 1; pointer-events: none;
    transition: opacity var(--dur-long) var(--ease-out);
  }
  .spinner-wrap.done { opacity: 0; }

  .spinner {
    width: 32px; height: 32px;
    border: 2px solid oklch(96% 0.006 75 / 0.08);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .image-area picture,
  .image-area img {
    position: relative; z-index: 2;
  }

  .image-area img {
    max-width: 100%; max-height: 100%;
    object-fit: contain;
    box-shadow: 0 20px 60px -20px oklch(0% 0 0 / 0.8);
  }

  .info {
    width: 100%;
    max-width: 900px;
    flex-shrink: 0;
    padding-top: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .photo-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--color-paper);
    text-align: center;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .exif {
    display: flex; flex-wrap: wrap;
    justify-content: center; gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: oklch(96% 0.006 75 / 0.45);
    letter-spacing: 0.03em;
  }

  .exif-dot {
    width: 3px; height: 3px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.3;
    align-self: center;
  }

  .share {
    display: inline-flex; align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: transparent;
    border: 1px solid oklch(96% 0.006 75 / 0.1);
    color: oklch(96% 0.006 75 / 0.5);
    font-family: var(--font-mono); font-size: var(--text-sm);
    cursor: pointer;
    border-radius: 999px;
    transition: all var(--dur-short) var(--ease-out);
  }
  .share:hover {
    border-color: var(--color-accent);
    color: var(--color-paper);
    background: var(--color-accent);
  }

  @media (max-width: 640px) {
    .content { padding: var(--space-md); }
    .image-area { max-height: calc(100vh - 180px); }
    .photo-title { font-size: var(--text-lg); }
    .exif { gap: 0.3rem; }
    .info { padding-top: var(--space-md); gap: var(--space-sm); }
  }
</style>
