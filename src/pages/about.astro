---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import yaml from "js-yaml";

const aboutGlob = import.meta.glob("../data/about.yaml", { query: "?raw", import: "default" });
const aboutRaw = await aboutGlob["../data/about.yaml"]() as string;
const aboutData = yaml.load(aboutRaw) as {
  title: string;
  bio: Array<{ section: string; content: string }>;
  gear: {
    primary?: Array<{ name: string; spec: string; description: string }>;
    secondary?: Array<{ name: string; spec: string; description: string }>;
    lenses?: Array<{ name: string; spec: string }>;
  };
  contact: { intro: string; links: Array<{ label: string; url: string }> };
};
---

<Layout title="About — Adrian Villanueva" description="Tokyo-based photographer. Bio, gear, and contact.">
  <Header currentPage="about" />

  <main id="main-content" class="page">
    <article class="about">
      <h1 class="page-title">About</h1>

      <div class="body">
        {aboutData.bio.map(section => (
          <section class="bio-section">
            <h2 class="section-title">{section.section}</h2>
            {section.content.split('\n').map(p => p.trim()).filter(Boolean).map(p => (
              <p>{p}</p>
            ))}
          </section>
        ))}

        <section class="gear-section">
          <h2 class="section-title">Camera Equipment</h2>
          {aboutData.gear.primary?.map(camera => (
            <div class="gear">
              <h3 class="gear-name">{camera.name}</h3>
              <p class="gear-spec mono">{camera.spec}</p>
              <p class="gear-desc">{camera.description}</p>
            </div>
          ))}
          {aboutData.gear.secondary?.map(camera => (
            <div class="gear">
              <h3 class="gear-name">{camera.name}</h3>
              <p class="gear-spec mono">{camera.spec}</p>
              <p class="gear-desc">{camera.description}</p>
            </div>
          ))}
          {aboutData.gear.lenses?.map(lens => (
            <div class="gear">
              <h4 class="gear-name">{lens.name}</h4>
              <p class="gear-spec mono">{lens.spec}</p>
            </div>
          ))}
        </section>

        <section class="contact-section">
          <h2 class="section-title">Get in Touch</h2>
          <p>{aboutData.contact.intro}</p>
          <div class="links">
            {aboutData.contact.links.map(link => (
              <a href={link.url} class="btn" target="_blank" rel="noopener noreferrer">{link.label}</a>
            ))}
          </div>
        </section>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-3xl) var(--page-gutter) 0;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-ink-2);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-xl);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-accent-dark);
    margin-bottom: var(--space-md);
    letter-spacing: -0.01em;
  }

  .bio-section p {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-muted);
    margin-bottom: var(--space-md);
  }

  .gear-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .gear {
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-rule);
  }

  .gear-name {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-ink-2);
    margin-bottom: var(--space-xs);
  }

  .gear-spec {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-neutral);
    margin-bottom: var(--space-sm);
    letter-spacing: 0.02em;
  }

  .mono { font-family: var(--font-mono); }

  .gear-desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-muted);
  }

  .contact-section p {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-muted);
    margin-bottom: var(--space-lg);
  }

  .links {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    text-decoration: none;
    transition: all var(--dur-short) var(--ease-out);
  }

  .btn:hover {
    color: var(--color-ink-2);
    border-color: var(--color-accent);
    background: oklch(72% 0.18 65 / 0.06);
  }

  @media (max-width: 640px) {
    .page { padding: var(--space-2xl) var(--page-gutter) 0; }
    .page-title { font-size: var(--text-xl); }
  }
</style>
