---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Stats from "../components/Stats.astro";
import yaml from "js-yaml";

interface Photo {
  id: string; title: string; image: string; thumbnail: string;
  metadata: { camera: string; lens: string; settings: { iso: number; aperture: string; shutter: string; focalLength: number | string; }; location: string; dateTaken: string; };
}

interface Collection { collection: string; description: string; photos: Photo[]; }

const statsGlob = import.meta.glob("../data/stats.yaml", { query: "?raw", import: "default" });
const statsRaw = await statsGlob["../data/stats.yaml"]() as string;
const statsData = yaml.load(statsRaw) as {
  title: string; subtitle: string;
  details: Array<{ label: string; title: string; description?: string; locations?: Array<{ name: string; description?: string }>; }>;
};

const collectionFiles = import.meta.glob("../data/collections/*.yaml", { query: "?raw", import: "default" });
const allPhotos: Photo[] = [];
for (const [_path, getContent] of Object.entries(collectionFiles)) {
  const content = (await getContent()) as string;
  const data = yaml.load(content) as Collection;
  allPhotos.push(...data.photos);
}

const photoCount = allPhotos.length;
const collectionCount = Object.keys(collectionFiles).length;
---

<Layout title="Statistics — Adrian Villanueva" description="Portfolio stats: photos, collections, locations.">
  <Header currentPage="stats" />

  <main id="main-content" class="page">
    <h1 class="page-title">Statistics</h1>
    <p class="subtitle">A glimpse into the archive.</p>

    <Stats photoCount={photoCount} collectionCount={collectionCount} />

    <div class="details">
      {statsData.details.map(detail => (
        <div class="card">
          <h2 class="card-title">{detail.title}</h2>
          {detail.label === 'Locations' && detail.locations && (
            <ul class="list">
              {detail.locations.map(loc => (
                <li class="list-item">
                  <strong>{loc.name}</strong>
                  {loc.description && <span>{loc.description}</span>}
                </li>
              ))}
            </ul>
          )}
          {detail.label === 'Collections' && (
            <p class="stat-line">{collectionCount} active collections</p>
          )}
          {detail.description && <p class="desc">{detail.description}</p>}
        </div>
      ))}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-3xl) var(--page-gutter) 0;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-ink-2);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
  }

  .subtitle {
    font-size: var(--text-base);
    color: var(--color-muted);
    margin-bottom: var(--space-xl);
  }

  .details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }

  .card {
    padding: var(--space-lg);
    border: 1px solid var(--color-rule);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-accent-dark);
    margin-bottom: var(--space-md);
    letter-spacing: -0.01em;
  }

  .list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .list-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.5;
  }

  .list-item strong {
    font-weight: 500;
    color: var(--color-ink-2);
  }

  .stat-line {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--color-accent);
    font-weight: 500;
  }

  .desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .page { padding: var(--space-2xl) var(--page-gutter) 0; }
    .details { grid-template-columns: 1fr; }
  }
</style>
