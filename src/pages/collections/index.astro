---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import yaml from "js-yaml";

interface Photo {
  id?: string; title: string; thumbnail: string; collection?: string;
  metadata?: { camera: string; lens: string; settings: { iso: number | number[]; aperture: string; shutter: string; focalLength: string | number; }; location: string; dateTaken: string; };
}

interface Collection { collection: string; description: string; photos: Photo[]; }

const collectionFiles = import.meta.glob("../../data/collections/*.yaml", { query: "?raw", import: "default" });
const collections: Array<{ data: Collection; slug: string }> = [];

for (const [path, getContent] of Object.entries(collectionFiles)) {
  const content = (await getContent()) as string;
  const data = yaml.load(content) as Collection;
  const slug = path.split("/").pop()?.replace(".yaml", "") || "";
  collections.push({ data, slug });
}

const totalPhotos = collections.reduce((sum, c) => sum + c.data.photos.length, 0);
const sortedCollections = collections.sort((a, b) => b.data.photos.length - a.data.photos.length);
---

<Layout title="Collections — Adrian Villanueva" description="Browse photography collections: urban and nature photography from Tokyo.">
  <Header currentPage="collections" />

  <main id="main-content" class="page">
    <div class="header">
      <h1 class="page-title">Collections</h1>
      <p class="subtitle mono">{collections.length} collections &middot; {totalPhotos} photographs</p>
    </div>

    <div class="grid">
      {sortedCollections.map((collection, index) => {
        const photo = collection.data.photos[0];
        const imageUrl = photo?.collection || photo?.image || '';
        const ext = imageUrl.match(/\.(\w+)$/)?.[1] || 'avif';
        const thumbUrl = imageUrl.replace(/-display\.\w+$/, '') + '-thumbnail.' + ext;
        return (
          <a href={`/collections/${collection.slug}`} class="card" style={`view-transition-name: coll-${index}`}>
            <div class="cover">
              <picture>
                <source srcset={thumbUrl} type={`image/${ext}`} />
                <img src={thumbUrl} alt={collection.data.collection} loading={index < 2 ? "eager" : "lazy"} />
              </picture>
            </div>
            <div class="info">
              <h2 class="name">{collection.data.collection}</h2>
              <p class="desc">{collection.data.description}</p>
              <span class="count mono">{collection.data.photos.length} photos</span>
            </div>
          </a>
        );
      })}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-3xl) var(--page-gutter) 0;
  }

  .header {
    margin-bottom: var(--space-2xl);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-ink-2);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
  }

  .subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    letter-spacing: 0.02em;
  }

  .mono { font-family: var(--font-mono); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-xl);
    padding-bottom: var(--space-3xl);
  }

  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-rule);
    transition: all var(--dur-short) var(--ease-out);
  }

  .card:hover {
    border-color: var(--color-accent);
  }

  .cover {
    aspect-ratio: 3/2;
    overflow: hidden;
    background: var(--color-paper-3);
  }

  .cover img,
  .cover picture {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .card:hover .cover img {
    transform: scale(1.04);
  }

  .info {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-ink-2);
    letter-spacing: -0.01em;
  }

  .desc {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.5;
  }

  .count {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-neutral);
    letter-spacing: 0.05em;
  }

  @media (max-width: 640px) {
    .page { padding: var(--space-2xl) var(--page-gutter) 0; }
    .grid { grid-template-columns: 1fr; gap: var(--space-lg); }
  }
</style>
