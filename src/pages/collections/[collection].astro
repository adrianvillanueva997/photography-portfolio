---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PhotoCard from "../../components/PhotoCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { generateCollectionSchema, uniqueIdFromImage, sortPhotosByDate } from "../../lib/imageMetadata.ts";
import yaml from "js-yaml";

interface Photo {
  id: string; title: string; image: string; thumbnail: string;
  metadata: { camera: string; lens: string; settings: { iso: number | number[]; aperture: string; shutter: string; focalLength: number | string; }; location: string; dateTaken: string; };
}

interface Collection { collection: string; description: string; photos: Photo[]; }

export async function getStaticPaths() {
  const collectionFiles = import.meta.glob("../../data/collections/*.yaml", { query: "?raw", import: "default" });
  const paths = [];
  for (const [path] of Object.entries(collectionFiles)) {
    const slug = path.split("/").pop()?.replace(".yaml", "") || "";
    paths.push({ params: { collection: slug } });
  }
  return paths;
}

const { collection } = Astro.params;
const collectionFiles = import.meta.glob("../../data/collections/*.yaml", { query: "?raw", import: "default" });

let data: Collection | null = null;
for (const [path, getContent] of Object.entries(collectionFiles)) {
  const slug = path.split("/").pop()?.replace(".yaml", "") || "";
  if (slug === collection) {
    const content = (await getContent()) as string;
    data = yaml.load(content) as Collection;
    break;
  }
}

if (!data) throw new Error(`Collection ${collection} not found`);

data.photos = sortPhotosByDate(data.photos);
const imageUrls = data.photos.map(photo => photo.image);
const collectionUrl = `https://avm.photography/collections/${collection}`;
const collectionSchema = generateCollectionSchema(data.collection, data.description, imageUrls, collectionUrl);
---

<Layout title={`${data.collection} — Adrian Villanueva`} description={data.description} image={data.photos[0]?.image}>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <Header currentPage="collections" />

  <main id="main-content">
    <div class="hero">
      <div class="hero-text">
        <Breadcrumbs collection={data.collection} />
        <h1 class="title">{data.collection}</h1>
        <p class="desc">{data.description}</p>
        <span class="count mono">{data.photos.length} photographs</span>
      </div>
    </div>

    <section class="gallery">
      <div class="grid">
        {data.photos.map(photo => (
          <PhotoCard
            id={uniqueIdFromImage(photo)}
            title={photo.title}
            image={photo.image}
            metadata={photo.metadata}
          />
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hero {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-3xl) var(--page-gutter) var(--space-lg);
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    color: var(--color-ink-2);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .desc {
    font-size: var(--text-base);
    color: var(--color-muted);
    max-width: 55ch;
    line-height: 1.5;
    margin-bottom: var(--space-sm);
  }

  .count {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-neutral);
    letter-spacing: 0.03em;
  }

  .mono { font-family: var(--font-mono); }

  .gallery {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--page-gutter) var(--space-3xl);
  }

  .grid {
    columns: 4;
    column-gap: var(--space-lg);
  }

  @media (max-width: 1200px) { .grid { columns: 3; } }
  @media (max-width: 900px)  { .grid { columns: 2; column-gap: var(--space-md); } }
  @media (max-width: 600px)  { .grid { columns: 1; } }
</style>
