---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="404 — Page Not Found" description="The page you're looking for doesn't exist.">
  <Header currentPage="home" />

  <main id="main-content" class="page">
    <div class="error">
      <h1 class="code">404</h1>
      <p class="msg">That frame didn't develop.</p>
      <div class="links">
        <a href="/" class="btn">Back home</a>
        <a href="/collections" class="btn">Browse collections</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .page {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2xl) var(--page-gutter);
  }

  .error {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    align-items: center;
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 15vw, 10rem);
    font-weight: 700;
    color: var(--color-rule);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .msg {
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .links {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    text-decoration: none;
    transition: all var(--dur-short) var(--ease-out);
  }

  .btn:hover {
    color: var(--color-ink-2);
    border-color: var(--color-accent);
    background: oklch(72% 0.18 65 / 0.06);
  }
</style>
