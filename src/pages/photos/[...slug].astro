---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Watermark from "../../components/Watermark.astro";
import { generateImageSchema, generatePersonSchema } from "../../lib/imageMetadata.ts";
import yaml from "js-yaml";

interface Photo {
  id: string; title: string; image: string; thumbnail: string;
  metadata: { camera: string; lens: string; settings: { iso: number | number[]; aperture: string; shutter: string; focalLength: number | string; }; location: string; dateTaken: string; };
}

interface Collection { collection: string; description: string; photos: Photo[]; }

export async function getStaticPaths() {
  const collectionFiles = import.meta.glob("../../data/collections/*.yaml", { query: "?raw", import: "default" });
  const paths: Array<{ params: { slug: string }; props: { photo: Photo; collection: string; prevSlug: string | null; nextSlug: string | null } }> = [];

  for (const [path, getContent] of Object.entries(collectionFiles)) {
    const content = (await getContent()) as string;
    const data = yaml.load(content) as Collection;
    const collectionSlug = path.split("/").pop()?.replace(".yaml", "") || "";
    const photos = data.photos;

    for (let i = 0; i < photos.length; i++) {
      const photo = photos[i];
      const slug = photo.image.split('/').pop()?.replace(/\.[^.]+$/, '') || photo.id;
      const prevSlug = i > 0 ? photos[i - 1].image.split('/').pop()?.replace(/\.[^.]+$/, '') || photos[i - 1].id : null;
      const nextSlug = i < photos.length - 1 ? photos[i + 1].image.split('/').pop()?.replace(/\.[^.]+$/, '') || photos[i + 1].id : null;
      paths.push({ params: { slug }, props: { photo, collection: collectionSlug, prevSlug, nextSlug } });
    }
  }
  return paths;
}

const { photo, collection, prevSlug, nextSlug } = Astro.props;

const isoValue = Array.isArray(photo.metadata.settings.iso) ? photo.metadata.settings.iso[0] : photo.metadata.settings.iso;
const imageSchema = generateImageSchema(photo.image, `${photo.title} — Adrian Villanueva`, {
  camera_make: photo.metadata.camera.split(' ')[0],
  camera_model: photo.metadata.camera,
  lens: photo.metadata.lens,
  iso: isoValue,
  aperture: photo.metadata.settings.aperture,
  shutter_speed: photo.metadata.settings.shutter,
  focal_length_35mm: String(photo.metadata.settings.focalLength),
  date_taken: photo.metadata.dateTaken,
});
const personSchema = generatePersonSchema();
const pageTitle = `${photo.title} — Photography by Adrian Villanueva`;
const baseUrl = photo.image.replace(/-display\.\w+$/, '');
const ext = photo.image.match(/\.(\w+)$/)?.[1] || 'avif';
const displayWebp = `${baseUrl}-display.webp`;
const thumbnailUrl = `${baseUrl}-thumbnail.${ext}`;
const displayUrl = `${baseUrl}-display.${ext}`;
---

<Layout title={pageTitle} description={`${photo.title} — captured in ${photo.metadata.location} with ${photo.metadata.camera}.`} image={photo.image}>
  <script type="application/ld+json" set:html={JSON.stringify(imageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <Header />

  <main id="main-content" class="page">
    <article class="photo-page">
      <div class="image-area">
        <picture>
          <source srcset={displayUrl} type="image/avif" />
          <source srcset={displayWebp} type="image/webp" />
          <img src={displayUrl} alt={photo.title} />
        </picture>
        <Watermark />
      </div>

      <div class="sidebar">
        <nav class="breadcrumbs">
          <a href="/collections">Collections</a>
          <span class="sep" aria-hidden="true">/</span>
          <a href={`/collections/${collection}`}>{collection}</a>
          <span class="sep" aria-hidden="true">/</span>
          <span class="current">{photo.title}</span>
        </nav>

        <h1 class="title">{photo.title}</h1>

        <dl class="meta">
          <div class="row">
            <dt>Camera</dt>
            <dd class="mono">{photo.metadata.camera.replace('RICOH IMAGING COMPANY, LTD. ', '')}</dd>
          </div>
          <div class="row">
            <dt>Lens</dt>
            <dd class="mono">{photo.metadata.lens}</dd>
          </div>
          <div class="row">
            <dt>Aperture</dt>
            <dd class="mono">{photo.metadata.settings.aperture}</dd>
          </div>
          <div class="row">
            <dt>Shutter</dt>
            <dd class="mono">{photo.metadata.settings.shutter}</dd>
          </div>
          <div class="row">
            <dt>ISO</dt>
            <dd class="mono">{isoValue}</dd>
          </div>
          <div class="row">
            <dt>Focal Length</dt>
            <dd class="mono">{photo.metadata.settings.focalLength}</dd>
          </div>
          <div class="row">
            <dt>Location</dt>
            <dd class="mono">{photo.metadata.location}</dd>
          </div>
          <div class="row">
            <dt>Date</dt>
            <dd class="mono">{photo.metadata.dateTaken.replace(/:/g, '.')}</dd>
          </div>
        </dl>

        <a href={`/collections/${collection}`} class="back mono">&larr; Back to {collection}</a>

        <nav class="nav-photos">
          {prevSlug && <a href={`/photos/${prevSlug}`} class="nav-link mono">Previous</a>}
          {nextSlug && <a href={`/photos/${nextSlug}`} class="nav-link mono">Next</a>}
        </nav>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<script define:vars={{ prevSlug, nextSlug }}>
  document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === 'ArrowLeft' && prevSlug) { window.location.href = '/photos/' + prevSlug; }
    if (e.key === 'ArrowRight' && nextSlug) { window.location.href = '/photos/' + nextSlug; }
  });
</script>

<style>
  .page {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-3xl) var(--page-gutter) 0;
  }

  .photo-page {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-xl);
    align-items: start;
  }

  .image-area {
    position: relative;
    background: oklch(12% 0.008 55);
    overflow: hidden;
  }

  .image-area img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 85vh;
    object-fit: contain;
  }

  .sidebar {
    position: sticky;
    top: 5rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .breadcrumbs a {
    color: var(--color-neutral);
    text-decoration: none;
    transition: color var(--dur-short) var(--ease-out);
  }
  .breadcrumbs a:hover { color: var(--color-accent); }

  .sep { color: var(--color-rule); }
  .current { color: var(--color-ink-2); }

  .title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--color-ink-2);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .meta {
    display: grid;
    gap: var(--space-sm);
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .row dt {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-neutral);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .row dd {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .mono { font-family: var(--font-mono); }

  .back {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-neutral);
    text-decoration: none;
    transition: color var(--dur-short) var(--ease-out);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule);
  }
  .back:hover { color: var(--color-accent); }

  .nav-photos {
    display: flex;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule);
  }

  .nav-link {
    flex: 1;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    text-decoration: none;
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    text-align: center;
    background: oklch(96% 0.003 75 / 0.4);
  }
  .nav-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: oklch(72% 0.18 65 / 0.08);
  }

  @media (max-width: 900px) {
    .photo-page { grid-template-columns: 1fr; gap: var(--space-lg); }
    .sidebar { position: static; }
    .page { padding: var(--space-2xl) var(--page-gutter) 0; }
    .title { font-size: var(--text-lg); }
  }

  @media (max-width: 480px) {
    .breadcrumbs { font-size: var(--text-sm); }
    .meta { gap: var(--space-sm); }
  }
</style>
