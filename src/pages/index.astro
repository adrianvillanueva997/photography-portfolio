---
/* Hallmark · macrostructure: Photographic · tone: atmospheric · anchor hue: amber (65°) */

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PhotoCard from "../components/PhotoCard.astro";
import { uniqueIdFromImage, sortPhotosByDate } from "../lib/imageMetadata.ts";
import yaml from "js-yaml";

interface Photo {
  id: string;
  title: string;
  image: string;
  collection?: string;
  thumbnail: string;
  metadata: {
    camera: string;
    lens: string;
    settings: { iso: number | number[]; aperture: string; shutter: string; focalLength: number | string; };
    location: string;
    dateTaken: string;
  };
}

interface Collection {
  collection: string;
  description: string;
  photos: Photo[];
}

const collectionFiles = import.meta.glob("../data/collections/*.yaml", { query: "?raw", import: "default" });
const allPhotos: Photo[] = [];

for (const [_path, getContent] of Object.entries(collectionFiles)) {
  const content = (await getContent()) as string;
  const data = yaml.load(content) as Collection;
  allPhotos.push(...data.photos);
}

const sortedPhotos = sortPhotosByDate(allPhotos);
const collectionCount = Object.keys(collectionFiles).length;
---

<Layout title="Adrian Villanueva — Photography Portfolio" description="Tokyo-based photographer. Urban landscapes, natural beauty, and live music.">
  <Header currentPage="home" />

  <main id="main-content">
    <section class="photo-grid">
      <div class="grid-header">
        <div>
          <p class="section-index mono">01 / SELECTED WORK</p>
          <h2>Photographs</h2>
        </div>
        <span class="grid-count mono">{sortedPhotos.length} photographs / {collectionCount} collections</span>
      </div>
      <div class="grid">
        {sortedPhotos.map(photo => (
          <PhotoCard
            id={uniqueIdFromImage(photo)}
            title={photo.title}
            image={photo.image}
            collection={photo.collection}
            thumbnail={photo.thumbnail}
            metadata={photo.metadata}
          />
        ))}
      </div>
    </section>

    <section class="about-band" aria-labelledby="about-title">
      <div class="section-index mono">02 / ABOUT</div>
      <div>
        <h2 id="about-title">Tokyo, by way of Spain.</h2>
        <p>Software engineer by day, photographer in my free time.</p>
        <a class="featured-link mono" href="/about">About the photographer <span aria-hidden="true">-&gt;</span></a>
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<script is:inline>
  document.addEventListener('click', function(e) {
    var trigger = e.target.closest('[data-lightbox-trigger]');
    if (!trigger) return;
    var id = trigger.getAttribute('data-lightbox-trigger');
    var lb = document.getElementById('lightbox-' + id);
    if (lb && lb.__open) { e.preventDefault(); lb.__open(); }
  });
</script>

<style>
  .photo-grid {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--space-3xl) var(--page-gutter) var(--space-3xl);
  }

  .section-index { color: var(--color-accent-dark); letter-spacing: 0.12em; font-size: var(--text-micro); }
  .featured-link { display: inline-flex; gap: 0.6rem; margin-top: var(--space-lg); color: var(--color-ink-2); font-size: var(--text-sm); }
  .featured-link:hover { color: var(--color-accent-2); }

  .grid-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-lg);
  }

  .grid-header h2 { margin-top: var(--space-xs); font-family: var(--font-display); font-size: var(--text-xl); font-weight: 500; color: var(--color-ink-2); }
  .about-band { max-width: 1200px; margin: var(--space-2xl) auto 0; padding: var(--space-lg) var(--page-gutter) var(--space-3xl); border-top: 1px solid var(--color-rule); display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-xl); }
  .about-band h2 { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 500; color: var(--color-ink-2); margin-bottom: var(--space-sm); }
  .about-band p { max-width: 54ch; color: var(--color-muted); line-height: 1.7; }

  .grid-count {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    letter-spacing: 0.03em;
  }

  .mono { font-family: var(--font-mono); }

  .grid {
    columns: 4;
    column-gap: var(--space-lg);
  }

  @media (max-width: 1200px) { .grid { columns: 3; } }
  @media (max-width: 900px)  { .grid { columns: 2; column-gap: var(--space-md); } }
  @media (max-width: 600px)  { .grid { columns: 1; } }
  @media (max-width: 700px) { .about-band { grid-template-columns: 1fr; gap: var(--space-md); } }
</style>
