---
/* Hallmark · macrostructure: Photographic · tone: atmospheric · anchor hue: amber (65°) */

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProfileSection from "../components/ProfileSection.astro";
import Stats from "../components/Stats.astro";
import PhotoCard from "../components/PhotoCard.astro";
import { uniqueIdFromImage, sortPhotosByDate } from "../lib/imageMetadata.ts";
import yaml from "js-yaml";

interface Photo {
  id: string;
  title: string;
  image: string;
  thumbnail: string;
  metadata: {
    camera: string;
    lens: string;
    settings: { iso: number | number[]; aperture: string; shutter: string; focalLength: number | string; };
    location: string;
    dateTaken: string;
  };
}

interface Collection {
  collection: string;
  description: string;
  photos: Photo[];
}

const collectionFiles = import.meta.glob("../data/collections/*.yaml", { query: "?raw", import: "default" });
const allPhotos: Photo[] = [];

for (const [_path, getContent] of Object.entries(collectionFiles)) {
  const content = (await getContent()) as string;
  const data = yaml.load(content) as Collection;
  allPhotos.push(...data.photos);
}

const sortedPhotos = sortPhotosByDate(allPhotos);
const collectionCount = Object.keys(collectionFiles).length;
---

<Layout title="Adrian Villanueva — Photography Portfolio" description="Tokyo-based photographer. Urban landscapes, natural beauty, and live music.">
  <Header currentPage="home" />

  <main id="main-content">
    <ProfileSection />

    <section class="photo-grid">
      <div class="grid-header">
        <span class="grid-count mono">{sortedPhotos.length} photographs across {collectionCount} collections</span>
      </div>
      <div class="grid">
        {sortedPhotos.map(photo => (
          <PhotoCard
            id={uniqueIdFromImage(photo)}
            title={photo.title}
            image={photo.image}
            metadata={photo.metadata}
          />
        ))}
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  .photo-grid {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--page-gutter) var(--space-3xl);
  }

  .grid-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-lg);
  }

  .grid-count {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    letter-spacing: 0.03em;
  }

  .mono { font-family: var(--font-mono); }

  .grid {
    columns: 4;
    column-gap: var(--space-lg);
  }

  @media (max-width: 1200px) { .grid { columns: 3; } }
  @media (max-width: 900px)  { .grid { columns: 2; column-gap: var(--space-md); } }
  @media (max-width: 600px)  { .grid { columns: 1; } }
</style>
